# Core
DATABASE_URL="postgresql://user:pass@localhost:5432/pembantu?schema=public"
DIRECT_URL="postgresql://user:pass@localhost:5432/pembantu?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="generate-via-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"

# SMS OTP (Twilio Verify)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SID=""
TWILIO_LOOKUP_ENABLED="false"

# Payments (Billplz)
BILLPLZ_API_KEY=""
BILLPLZ_COLLECTION_ID=""
BILLPLZ_X_SIGNATURE=""
BILLPLZ_API_BASE="https://www.billplz-sandbox.com/api/v3"

# Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Realtime (Pusher)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM="Pembantu <noreply@example.com>"

# Jobs (Inngest)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Rate-limit / cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Maps (Google)
GOOGLE_MAPS_SERVER_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# Observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Admin bootstrap (auto-grants ADMIN on first login)
ADMIN_BOOTSTRAP_PHONES=""

# Feature flags (off by default — high-trust categories need TIER_1 verification first)
FEATURE_CHILDCARE_ENABLED="false"
FEATURE_ELDERCARE_ENABLED="false"
FEATURE_DRIVER_ENABLED="false"
FEATURE_BEAUTY_WELLNESS_ENABLED="false"
FEATURE_SUPERLIKE_ENABLED="true"

# Dev-only shortcut, NEVER true in production
DEV_OTP_BYPASS="1"
