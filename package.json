{
  "name": "pembantu-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.3.3",
    "better-auth": "^1.6.11",
    "framer-motion": "^12.38.0",
    "inngest": "^4.4.0",
    "next": "^15.5.18",
    "next-intl": "^4.12.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.76.0",
    "resend": "^6.12.3",
    "serwist": "^9.5.11",
    "twilio": "^4.22.0",
    "zod": "^4.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@serwist/next": "^9.5.11",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
